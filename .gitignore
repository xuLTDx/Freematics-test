# Build artifacts
*.o
*.a
*.so
*.exe

# CodeQL
_codeql_detected_source_root

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Arduino
*.elf
*.bin
*.hex

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Claude Code local settings (personal, machine-specific - not for the team/public fork)
.claude/

# OTA server: device tokens + TLS key are secrets, never commit them.
# See server/ota-server/registry.example.json for the expected shape.
server/ota-server/registry.json
server/ota-server/*.pem
server/ota-server/server.log
# See server/ota-server/traccar_credentials.example.json for the expected shape.
server/ota-server/traccar_credentials.json
server/ota-server/*.log

# firmware_v5/telelogger/publish_ota.py's config: maps PlatformIO env -> the
# device's registry.json token - a token is a bearer credential, never commit.
# See publish_ota_config.example.json for the expected shape.
firmware_v5/telelogger/publish_ota_config.json
