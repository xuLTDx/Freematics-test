[Unit]
Description=Freematics OTA push-decision watcher
After=network.target freematics-ota.service

[Service]
Type=simple
User=freematics-ota
WorkingDirectory=/opt/freematics-ota
ExecStart=/usr/bin/python3 /opt/freematics-ota/ota_push_watcher.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
